# Gemini (required for AI chat — get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional model override (default gemini-3.6-flash; gemini-2.5-flash is sunset for new API projects)
GEMINI_MODEL=

# Smartcar Connect (test mode / Simulator) — from your Smartcar dashboard
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Smartcar dashboard,
# e.g. http://localhost:8000/callback or https://<your-app>.onrender.com/callback
SMARTCAR_REDIRECT_URI=
# "simulated" (Smartcar Simulator) or "test" (legacy test mode)
SMARTCAR_MODE=simulated
